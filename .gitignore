# Config lokal Suitest — berisi kredensial test (username/password OSS)
suitest.config.json

# Draft issue internal Suitest
SUITEST_RECORDER_ISSUE.md

# Script integrasi/impor hasil ke Suitest TCM
scripts/suitest-ingest.mjs

# Folder temp hasil generate test Suitest
test-tmp/

# ===== Tetap di-commit (Playwright & template) =====
# .env.example  -> placeholder aman, wajib di-commit sebagai template
# .github/      -> workflow CI (Playwright)
# tests/, playwright.config.js, package.json -> kode & config Playwright
